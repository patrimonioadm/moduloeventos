# Copie para .env.local e preencha com os dados do SEU projeto Supabase.
# Nunca coloque a service_role key aqui — ela só existe no servidor
# (variável de ambiente da Edge Function), nunca em código de front-end.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=coloque-a-anon-key-aqui

# URLs de cada módulo já implantado (deixe em branco enquanto "em_breve")
VITE_URL_EVENTOS=
VITE_URL_PATRIMONIO=https://descartes-dkp.vercel.app
